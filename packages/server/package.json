{
  "name": "@mnestia/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun run --watch ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun run ./dist/index.js",
    "test": "bun test test/",
    "lint": "oxlint --config ../../oxlint.json .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/platform": "^0.94.5",
    "@effect/platform-bun": "^0.87.1",
    "@mnestia/core": "workspace:*",
    "@mnestia/schema": "workspace:*",
    "@tanstack/ai": "^0.5.0",
    "@tanstack/ai-openai": "^0.5.0",
    "@valibot/to-json-schema": "^1.5.0",
    "effect": "^3.19.18",
    "elysia": "latest",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.74.0",
    "bun-types": "latest",
    "typescript": "^5.9.3"
  }
}
