{
  "name": "@mnestia/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "mnestia-server": "./bin/server.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "bun run --watch ./src/index.ts",
    "build": "tsdown",
    "start": "node ./bin/server.mjs",
    "test": "bun test test/",
    "lint": "oxlint --config ../../oxlint.json .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.61.0",
    "@effect/platform": "^0.94.5",
    "@effect/platform-bun": "^0.87.1",
    "@mnestia/core": "workspace:*",
    "@mnestia/schema": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@opentelemetry/sdk-trace-node": "^2.5.1",
    "@sentry/bun": "^10.39.0",
    "@sentry/opentelemetry": "^10.39.0",
    "effect": "^3.19.18",
    "elysia": "latest",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.74.0",
    "bun-types": "latest",
    "typescript": "^5.9.3"
  }
}
