{
  "name": "@mnestia/server",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun run --watch ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun run ./dist/index.js",
    "test": "bun test",
    "lint": "oxlint --config ../../oxlint.json .",
    "format": "oxlint --format --ignore-pattern 'dist/**' .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mnestia/core": "workspace:*",
    "elysia": "latest"
  },
  "devDependencies": {
    "bun-types": "latest",
    "oxlint": "^0.15.12",
    "typescript": "^5.7.3"
  }
}
