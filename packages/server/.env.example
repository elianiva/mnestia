# ── @mnestia/server Environment Variables ──────────────────────────
# Copy this file to .env and fill in the values.
# All variables are loaded via Effect Config at startup.

# ── Server ─────────────────────────────────────────────────────────

# Port the server listens on (default: 3000)
PORT=3000

# Hostname the server binds to (default: localhost)
HOST=localhost

# ── AI / Agent ─────────────────────────────────────────────────────

# OpenAI API key for the AI agent integration (optional).
# If not set, POST /agent/chat will return 503.
# OPENAI_API_KEY=sk-...

# ── Sentry / Tracing ──────────────────────────────────────────────

# Sentry DSN for error tracking and tracing (optional).
# If not set, tracing is disabled.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry environment tag (default: dev)
SENTRY_ENVIRONMENT=dev

# OpenTelemetry traces sample rate 0.0–1.0 (default: 1.0)
SENTRY_TRACES_SAMPLE_RATE=1.0

# Enable console span exporter for local debugging (default: false)
OTEL_CONSOLE_TRACE=false
