# ── @mnestia/server Environment Variables ──────────────────────────
# Copy this file to .env and fill in the values.
# All variables are loaded via Effect Config at startup.

# ── Server ─────────────────────────────────────────────────────────

# Port the server listens on (default: 3000)
PORT=3000

# Hostname the server binds to (default: localhost)
HOST=localhost

# ── AI / Agent ─────────────────────────────────────────────────────

# OpenAI API key for the AI agent integration (optional).
# If not set, POST /agent/chat will return 503.
# OPENAI_API_KEY=sk-...
