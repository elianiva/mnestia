{
  "name": "@mnestia/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define-deck": {
      "types": "./dist/utils/define-deck.d.ts",
      "import": "./dist/utils/define-deck.js"
    },
    "./slide": {
      "types": "./dist/utils/slide.d.ts",
      "import": "./dist/utils/slide.js"
    },
    "./services/deck": {
      "types": "./dist/services/deck-service.d.ts",
      "import": "./dist/services/deck-service.js"
    },
    "./services/theme": {
      "types": "./dist/services/theme-service.d.ts",
      "import": "./dist/services/theme-service.js"
    },
    "./atoms/deck": {
      "types": "./dist/atoms/deck-atom.d.ts",
      "import": "./dist/atoms/deck-atom.js"
    },
    "./atoms/clicks": {
      "types": "./dist/atoms/clicks-atom.d.ts",
      "import": "./dist/atoms/clicks-atom.js"
    },
    "./hooks/use-deck": {
      "types": "./dist/hooks/use-deck.d.ts",
      "import": "./dist/hooks/use-deck.js"
    },
    "./hooks/use-clicks": {
      "types": "./dist/hooks/use-clicks.d.ts",
      "import": "./dist/hooks/use-clicks.js"
    },
    "./hooks/use-navigation": {
      "types": "./dist/hooks/use-navigation.d.ts",
      "import": "./dist/hooks/use-navigation.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --config ../../oxlint.json --ignore-pattern 'dist/**' .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect-atom/atom-react": "^0.5.0",
    "@effect/platform": "^0.94.5",
    "@effect/platform-bun": "^0.87.1",
    "@mnestia/schema": "workspace:*",
    "effect": "^3.19.18"
  },
  "devDependencies": {
    "@effect/language-service": "^0.74.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.3"
  }
}
