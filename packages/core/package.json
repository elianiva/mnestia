      "types": "./src/utils/define-deck.ts",
      "import": "./src/utils/define-deck.ts"
    },
    "./slide": {
      "types": "./src/utils/slide.ts",
      "import": "./src/utils/slide.ts"
    },
    "./services/deck": {
      "types": "./src/services/deck-service.ts",
      "import": "./src/services/deck-service.ts"
    },
    "./services/theme": {
      "types": "./src/services/theme-service.ts",
      "import": "./src/services/theme-service.ts"
    },
    "./atoms/deck": {
      "types": "./src/atoms/deck-atom.ts",
      "import": "./src/atoms/deck-atom.ts"
    },
    "./atoms/clicks": {
      "types": "./src/atoms/clicks-atom.ts",
      "import": "./src/atoms/clicks-atom.ts"
    },
    "./hooks/use-deck": {
      "types": "./src/hooks/use-deck.ts",
      "import": "./src/hooks/use-deck.ts"
    },
    "./hooks/use-clicks": {
      "types": "./src/hooks/use-clicks.ts",
      "import": "./src/hooks/use-clicks.ts"
    },
    "./hooks/use-navigation": {
      "types": "./src/hooks/use-navigation.ts",
