{
  "extends": "../../tsconfig.options.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "virtual:mnestia/deck": ["./src/virtual.d.ts"],
      "virtual:mnestia/slides": ["./src/virtual.d.ts"],
      "virtual:mnestia/themes": ["./src/virtual.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
