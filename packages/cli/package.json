{
  "name": "@mnestia/cli",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "mnestia": "./dist/index.js",
    "create-mnestia": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch ./src/index.ts",
    "run": "bun ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir=./dist --target=bun --minify",
    "lint": "oxlint --config ../../oxlint.json --ignore-pattern 'dist/**' .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "effect-language-service patch"
  },
  "devDependencies": {
    "@effect/language-service": "^0.74.0",
    "@effect/platform-node": "^0.104.1",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@effect/cli": "^0.73.2",
    "@effect/platform": "^0.94.5",
    "@effect/platform-bun": "^0.87.1",
    "@effect/printer-ansi": "^0.47.0",
    "@mnestia/vite-plugin": "workspace:*",
    "effect": "^3.19.18",
    "jiti": "^2.4.2",
    "kleur": "^4.1.5",
    "vite": "^7.1.7"
  }
}
