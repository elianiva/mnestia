{
  "name": "@mnestia/schema",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./deck": {
      "types": "./src/deck.ts",
      "import": "./src/deck.ts",
      "default": "./src/deck.ts"
    },
    "./slide": {
      "types": "./src/slide.ts",
      "import": "./src/slide.ts",
      "default": "./src/slide.ts"
    },
    "./navigation": {
      "types": "./src/navigation.ts",
      "import": "./src/navigation.ts",
      "default": "./src/navigation.ts"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "import": "./src/theme.ts",
      "default": "./src/theme.ts"
    },
    "./export": {
      "types": "./src/export.ts",
      "import": "./src/export.ts",
      "default": "./src/export.ts"
    },
    "./ws-events": {
      "types": "./src/ws-events.ts",
      "import": "./src/ws-events.ts",
      "default": "./src/ws-events.ts"
    },
    "./ai-commands": {
      "types": "./src/ai-commands.ts",
      "import": "./src/ai-commands.ts",
      "default": "./src/ai-commands.ts"
    },
    "./server-slide": {
      "types": "./src/server-slide.ts",
      "import": "./src/server-slide.ts",
      "default": "./src/server-slide.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly",
    "dev": "tsc --emitDeclarationOnly --watch",
    "lint": "oxlint --config ../../oxlint.json --ignore-pattern 'dist/**' .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@valibot/to-json-schema": "^1.5.0",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  }
}
