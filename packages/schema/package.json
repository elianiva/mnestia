{
  "name": "@mnestia/schema",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly",
    "dev": "tsc --emitDeclarationOnly --watch",
    "lint": "oxlint --config ../../oxlint.json --ignore-pattern 'dist/**' .",
    "format": "oxlint --format --ignore-pattern 'dist/**' .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.3"
  }
}
