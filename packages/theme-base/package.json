{
  "name": "@mnestia/theme-base",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    },
    "./components/code-block": {
      "types": "./dist/components/code-block.d.ts",
      "import": "./dist/components/code-block.js"
    },
    "./components/image": {
      "types": "./dist/components/image.d.ts",
      "import": "./dist/components/image.js"
    },
    "./components/quote": {
      "types": "./dist/components/quote.d.ts",
      "import": "./dist/components/quote.js"
    },
    "./components/table": {
      "types": "./dist/components/table.d.ts",
      "import": "./dist/components/table.js"
    },
    "./layouts/default": {
      "types": "./dist/layouts/default.d.ts",
      "import": "./dist/layouts/default.js"
    },
    "./layouts/cover": {
      "types": "./dist/layouts/cover.d.ts",
      "import": "./dist/layouts/cover.js"
    },
    "./layouts/center": {
      "types": "./dist/layouts/center.d.ts",
      "import": "./dist/layouts/center.js"
    },
    "./layouts/split": {
      "types": "./dist/layouts/split.d.ts",
      "import": "./dist/layouts/split.js"
    },
    "./layouts/grid": {
      "types": "./dist/layouts/grid.d.ts",
      "import": "./dist/layouts/grid.js"
    },
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && cp -r src/styles dist/styles",
    "dev": "tsdown --watch",
    "lint": "oxlint --config ../../oxlint.json --ignore-pattern 'dist/**' .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mnestia/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3"
  }
}
